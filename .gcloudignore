# Upload filter for `gcloud builds submit` / `gcloud run deploy --source .` (HydrologyMIP web portal).
# Uses .gitignore syntax. When this file exists, gcloud ignores .gitignore, so every
# exclusion is listed explicitly here.

# --- VCS, CI, and local tooling ---
.gcloudignore
.git/
.gitignore
.github/
.idea/
.vscode/
.DS_Store

# --- Python caches and build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Virtual environments and secrets ---
.venv/
venv/
.env
.env.*
.envrc

# --- Large data bundles, hydrographs, checkpoints, and uploads ---
mips/*/data/*.npz
mips/*/data/*.npy
*.npz
*.npy
*.zarr/
*.zarr.zip
*.zip
*.pt
*.pth
*.ckpt
*.safetensors
hydrographs/
submissions/
outputs/
local_bucket/
*.local.json

# --- Not needed by the portal service ---
models/
skills/
mips/*/era_experiments/
tests/
.ipynb_checkpoints/
*.log
*.tmp
